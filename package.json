{
  "name": "@obvia/collections",
  "version": "0.1.0",
  "description": "Immutable, fluent and deeply typed collections for TypeScript.",
  "type": "module",
  "packageManager": "bun@1.4.2",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./collection": {
      "types": "./dist/collection.d.ts",
      "import": "./dist/collection.js",
      "require": "./dist/collection.cjs",
      "default": "./dist/collection.js"
    },
    "./collect": {
      "types": "./dist/collect.d.ts",
      "import": "./dist/collect.js",
      "require": "./dist/collect.cjs",
      "default": "./dist/collect.js"
    },
    "./package.json": "./package.json"
  },
  "imports": {
    "#collections": "./src/index.ts"
  },
  "files": [
    "dist",
    "src",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "clean": "bun -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsdown",
    "typecheck": "tsc -p tsconfig.json",
    "test:unit": "bun test tests/unit",
    "test:behavior": "bun test tests/behavior",
    "test:guards": "bun test tests/guards",
    "test:contracts": "bun test tests/contracts",
    "test:properties": "bun test tests/properties",
    "test:performance": "bun test tests/performance",
    "test:runtime": "bun test tests/unit tests/behavior tests/guards tests/contracts tests/properties tests/performance",
    "test:coverage": "bun -e \"import { rmSync } from 'node:fs'; rmSync('coverage', { recursive: true, force: true })\" && bun test --coverage tests/unit tests/behavior tests/guards tests/contracts tests/properties tests/performance",
    "test": "bun run typecheck && bun run test:runtime",
    "benchmark": "bun run benchmarks/collection.bench.ts",
    "benchmark:ci": "bun run benchmarks/collection.bench.ts --profile=ci",
    "check": "bun run test",
    "prepublishOnly": "bun run check",
    "verify:package": "bun run build && npm pack --dry-run --ignore-scripts",
    "prepack": "bun run build"
  },
  "keywords": [
    "collection",
    "collections",
    "typescript",
    "immutable",
    "fluent",
    "iterable",
    "typed",
    "utility"
  ],
  "author": "Selçuk Çukur <selcukcukur@outlook.com.tr>",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "7.0.2",
    "tsdown": "^0.23.0"
  }
}
